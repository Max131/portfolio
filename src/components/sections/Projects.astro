---
import { defaultLang } from "@i18n/ui.ts";
import { useTranslation } from "@i18n/utils.ts";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { isURL } from "@utils/index";
import { getAbsoluteLocaleUrl } from "astro:i18n";

const currentLocale = Astro.currentLocale || defaultLang;
const t = useTranslation(currentLocale);
const localeURL = getAbsoluteLocaleUrl(currentLocale);

const projects = (
  await getCollection(
    "projects",
    (project) => project.data.featured && project.id.startsWith(currentLocale),
  )
).sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<section id="projects" class="mb-16">
  <h2 class="font-title font-bold mb-4 text-2xl">{t("projects.title")}</h2>
  <div
    class="text-lg *:[p]:mb-4 *:[:first-child]:text-stone-400"
    set:html={t("projects.content")}
  />
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 my-16">
    {
      projects.map((project, i) => (
        <article class:list={[
          "group rounded-lg border border-stone-200 bg-white flex flex-col overflow-hidden transition-all duration-300 hover:border-teal-600 hover:shadow-sm hover:-translate-y-0.5",
          `stagger-${Math.min(i + 1, 5)}`,
        ]}>
          <a
            class="outline-0"
            href={`/${currentLocale !== defaultLang ? currentLocale + "/" : ""}projects/${project.slug}`}
            aria-label={project.data.title}
          >
            <Image
              class="w-full aspect-video object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              src={
                isURL(project.data.thumbnail)
                  ? project.data.thumbnail
                  : `/images/projects/${project.data.thumbnail}`
              }
              width={480}
              height={270}
              alt={project.data.title}
            />
          </a>
          <div class="flex flex-col flex-1 px-5 py-4">
            <h3 class="font-title font-semibold text-lg mb-2">
              <a
                class="transition-colors duration-200 hover:text-teal-600"
                href={`/${currentLocale !== defaultLang ? currentLocale + "/" : ""}projects/${project.slug}`}
              >
                {project.data.title}
              </a>
            </h3>
            <p class="text-sm leading-relaxed text-stone-500">{project.data.summary}</p>
            <ul class="mt-auto pt-4 flex flex-wrap gap-1.5">
              {project.data.tags?.map((tag) => (
                <li class="text-xs font-medium px-2 py-0.5 rounded border border-stone-200 text-stone-500">
                  {tag}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
    <a
      href={`${localeURL}projects`}
      class="group grid place-items-center rounded-lg border border-dashed border-stone-300 p-8 transition-all duration-300 hover:border-teal-600 hover:text-teal-600"
    >
      <span class="text-5xl font-bold text-stone-300 group-hover:text-teal-600 transition-colors duration-300">+</span>
      <span class="text-sm font-medium text-stone-400 group-hover:text-teal-600 transition-colors duration-300 mt-2">{t("projects.seeMore")}</span>
    </a>
  </div>
</section>
